<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
    <link href='style.css' rel="stylesheet"/>
	<title>Новый пароль</title>
</head>
<body>
	<div class="container">
		<div id="LoginAndRegistrationForm">
			<h1 id="formTitle">Новый пароль</h1>
			<div id="ResetPasswordForm">
				<form method="post" action="changePass">
					<div class="center">
						<input type="hidden" name="usrID" value="{{usrID}}">
						<input type="hidden" name="token" value="{{token}}">
						<input id="NewPassword" name="NewPassword" class="mt-10 input-text" type="password" placeholder="Пароль">
						<input id="ConfirmNewPassword" name="ConfirmNewPassword" class="mt-10 input-text" type="password" placeholder="Повторите пароль">
					</div>
					<div class="center mt-20">
						<input onclick="return ValidateResetPasswordForm()" class="Submit-Btn" type="submit" value="Change" id="PasswordChangeBtn">
					</div>
				</form>
			</div>

		</div>
	</div>
    <script src="validation.js" type="text/javascript"></script>
</body>
</html>
