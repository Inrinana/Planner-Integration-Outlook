<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link href='style.css' rel="stylesheet"/>
	<title>Вход</title>
</head>

<body>
	<div class="container">
		<div id="LoginAndRegistrationForm">
			<h1 id="formTitle">Войти в систему</h1>
			<div id="LoginFrom">
				<form method='post' action='db_authorize'>
					<div class="center">
						<input id="LoginEmail" name="logname" class="input-text" type="text" placeholder="Email">
						<input id="LoginPassword" name="logpsw" class="mt-10 input-text" type="password" placeholder="Пароль">
						<a class = 'error-message'>{{mess}}</a> 
					</div>
					
					<div class="forgot-pass-remember-me mt-10">
						<div class="forgot-pass">
							<a id="ForgotPassword" href="JavaScript:void(0);" onclick="ShowForgotPasswordForm()" >Забыли пароль?</a>
						</div>
					</div>

					<div class="center mt-20">
						<input  onclick="return ValidateLoginForm();" class="Submit-Btn" type="submit" value="Войти" id="LoginBtn">
					</div>
				</form>
				<div class="center mt-20">
						<a class="Submit-Btn" type="submit" href="{{signInUrl}}" >Подключить почту</a>
				</div>
				<p class="center mt-20 dont-have-account">
				</p>
			</div>
			
			<div id="ForgotPasswordForm">
				<form method='post'  action="resetPass">
					<div class="center mt-20">
						<input class="input-text " type="email" id="forgotPassEmail" placeholder="Email" name="email">
					</div>
					<div class="center mt-20">
						<input onclick="return ValidateForgotPasswordForm();" class="Submit-Btn" type="submit" value="Отправить пароль" id="PasswordResetBtn" >
					</div>
				</form>
				<p class="center mt-20 already-have-account">
					Назад к 
					<a  onclick="ShowLoginForm()">Вход в систему</a>
				</p>
			</div>
		</div>
		<p style="text-align: center; text-decoration: none; color: #747474; font-weight: bolder">Российские Железные Дороги</p>
	</div>
	<script src="main.js" type="text/javascript"></script>
	<script src="validation.js" type="text/javascript"></script>
</body>
</html>